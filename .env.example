# PLAN.md sec.8: .env.example - DB_PATH, API_PORT, LOG_LEVEL
#
# Copy to `.env` and edit. These override the same keys in config.yaml, keeping
# machine-specific paths out of git. Everything ELSE is configured in
# config.yaml, not here.

# Path to the SQLite database. Relative paths resolve against the repo root.
DB_PATH=data/pledgecast.db

# Port uvicorn serves the inference API on.
API_PORT=8000

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
