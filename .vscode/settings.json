{
  // Hide generated/vendored trees from the explorer. Without this the editor
  // walks the ~52,000 files inside .venv and reports a huge change count that
  // git itself never sees.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/*.egg-info": true
  },

  // Keep the file watcher off those trees too - this is what actually stops the
  // "10k+ changes" counter and the CPU spikes.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/data/raw/**": true,
    "**/logs/**": true,
    "**/.git/objects/**": true
  },

  // Exclude them from search results as well.
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/data/raw": true,
    "**/logs": true,
    "**/models/*.joblib": true
  },

  // The venv lives inside the repo at .venv/ (excluded from git via .gitignore).
  // VS Code hides it from the explorer above to avoid indexing ~52,000 files.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.venvPath": "${workspaceFolder}",
  // Root + src mirror scripts/_bootstrap.py at runtime and pytest.ini's
  // `pythonpath` under test; `scripts` is added so the `import _bootstrap`
  // line inside each numbered script resolves in the editor too.
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/src",
    "${workspaceFolder}/scripts"
  ],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
