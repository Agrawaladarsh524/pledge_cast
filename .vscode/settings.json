{
  // Hide generated/vendored trees from the explorer. Without this the editor
  // walks the ~52,000 files inside .venv and reports a huge change count that
  // git itself never sees.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/*.egg-info": true
  },

  // Keep the file watcher off those trees too - this is what actually stops the
  // "10k+ changes" counter and the CPU spikes.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/data/raw/**": true,
    "**/logs/**": true,
    "**/.git/objects/**": true
  },

  // Exclude them from search results as well.
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/data/raw": true,
    "**/logs": true,
    "**/models/*.joblib": true
  },

  // The venv lives OUTSIDE the repo so the editor never indexes its ~52,000
  // site-packages files. Point the interpreter at it explicitly.
  "python.defaultInterpreterPath": "${workspaceFolder}/../pledgecast_venv/Scripts/python.exe",
  // Because the venv sits OUTSIDE the workspace, VS Code will not auto-discover
  // it and falls back to the system Python - which has none of the pinned
  // packages, so every `import lxml` / `import pandas` shows as unresolved.
  // This points the interpreter picker at the parent directory.
  // If imports still show red, run "Python: Select Interpreter" once and pick
  // pledgecast_venv.
  "python.venvPath": "${workspaceFolder}/..",
  // Root + src mirror scripts/_bootstrap.py at runtime and pytest.ini's
  // `pythonpath` under test; `scripts` is added so the `import _bootstrap`
  // line inside each numbered script resolves in the editor too.
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/src",
    "${workspaceFolder}/scripts"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // ruff is the one linter/formatter (PLAN sec.4).
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false,
    "editor.rulers": [100]
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
